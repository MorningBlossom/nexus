# Copy this file to .env and fill in the values needed by your deployment.
# Secret environment variables are encrypted at rest using AES-GCM.
# Generate a 32-byte key with: openssl rand -hex 16
NEXUS_ENCRYPTION_KEY=

MONGODB_URL=
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_INSTALLATION_ID=
GITHUB_PAT=
GITHUB_WEBHOOK_SECRET=
FRONTEND_STATIC_PATH=./frontend
